{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec wrangler pages dev dist --ip 127.0.0.1 --port 4322",
      "startServerReadyPattern": "Ready on",
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/products/ai-visibility/",
        "http://127.0.0.1:4322/products/commerce-intelligence/",
        "http://127.0.0.1:4322/products/supplier-operations/",
        "http://127.0.0.1:4322/products/bid-operations/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --force-prefers-reduced-motion"
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 100
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
