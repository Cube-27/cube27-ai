{
  "name": "cube27-ai",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "astro dev --port 3200",
    "build": "astro build",
    "preview": "wrangler pages dev dist --port 8788",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:build": "node scripts/validate-build.mjs",
    "links:check": "linkinator dist --recurse --skip ai.cube27.com",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "lighthouse": "lhci autorun",
    "verify": "node scripts/verify.mjs",
    "verify:all": "pnpm verify && pnpm test:e2e && pnpm lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "schema-dts": "^2.0.0",
    "sharp": "0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "linkinator": "^8.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
