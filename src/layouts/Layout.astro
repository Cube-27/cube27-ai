---
import "@/styles/fonts.css";
import "@/styles/globals.css";
import { getImage } from "astro:assets";
import { SITE } from "@/data/site";
import type { JsonLd } from "@/lib/schema";
import heroTopology from "@/assets/images/hero-topology.png";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: JsonLd;
}

const {
  title = SITE.name,
  description = SITE.description,
  canonical = `${SITE.url}/`,
  image = `${SITE.url}/social-preview.jpg`,
  imageAlt = "Cube27 AI production systems control room.",
  noindex = false,
  jsonLd,
} = Astro.props;

const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large";
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : undefined;
const heroPreloads = noindex
  ? []
  : await Promise.all(
      [640, 960, 1280, 1600].map((width) =>
        getImage({ src: heroTopology, width, format: "avif" }),
      ),
    );
const heroSrcset = heroPreloads
  .map((asset, index) => `${asset.src} ${[640, 960, 1280, 1600][index]}w`)
  .join(", ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070b12" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/cube27-mark.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      !noindex && (
        <link
          rel="preload"
          as="image"
          href={heroPreloads[2]?.src}
          imagesrcset={heroSrcset}
          imagesizes="100vw"
          type="image/avif"
          fetchpriority="high"
        />
      )
    }

    {
      serializedJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializedJsonLd}
        />
      )
    }
    <script
      is:inline
      defer
      src="/analytics.js"
      data-measurement-id={SITE.analyticsId}></script>
  </head>
  <body>
    <!--
    THESIS: Inference Control Room turns a marketing page into one traced production system and refuses disconnected landing-page bands.
    OWN-WORLD: Midnight graphite, signal cyan, verified chartreuse, hairline routes, square instrument panels, and precise operational typography.
    STORY: Visitors understand Cube27's grounded AI posture, inspect its patterns and product proof, then continue to a working conversation.
    FIRST VIEWPORT: Fixed header and signal rail frame an asymmetric declaration, full-bleed topology field, deployment lens, and cyan primary action.
    FORM: User-pinned live demo reference; seed key pinned-demo-inference-control-room.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
