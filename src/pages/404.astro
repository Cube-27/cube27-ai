---
import Button from "@/components/ui/Button.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page not found — CUBE27 AI"
  description="The requested CUBE27 AI page could not be found."
  noindex
>
  <section class="band band--canvas">
    <div class="shell nf">
      <SectionHead
        eyebrow="404"
        level={1}
        size="h2"
        title="We could not find that page."
        lead="The link may be out of date. Our product systems and capabilities are all reachable from the homepage."
      >
        <div class="btn-row btn-row--center">
          <Button href="/" variant="primary">Back to CUBE27 AI</Button>
          <Button href="/#products" variant="quiet">Explore our products</Button
          >
        </div>
      </SectionHead>
    </div>
  </section>
</Layout>
