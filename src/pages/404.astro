---
import { ArrowLeft } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page not found — Cube27 AI"
  description="The requested Cube27 AI page could not be found."
  noindex
>
  <main class="error-page">
    <p class="eyebrow"><span class="eyebrow-dot"></span>SYS: 404</p>
    <h1>Signal path not found.</h1>
    <p>The requested route is outside this system.</p>
    <a class="primary-button" href="/"
      ><ArrowLeft size={17} /> Return to Cube27 AI</a
    >
  </main>
</Layout>
