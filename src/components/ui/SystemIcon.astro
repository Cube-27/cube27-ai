---
import {
  Activity,
  Bot,
  BrainCircuit,
  ClipboardCheck,
  Database,
  Gauge,
  MessagesSquare,
  SearchCheck,
  ShieldCheck,
} from "@lucide/astro";

const icons = {
  activity: Activity,
  bot: Bot,
  brain: BrainCircuit,
  clipboard: ClipboardCheck,
  database: Database,
  gauge: Gauge,
  messages: MessagesSquare,
  search: SearchCheck,
  shield: ShieldCheck,
} as const;

interface Props {
  name: keyof typeof icons;
  size?: number;
}

const { name, size = 18 } = Astro.props;
const Icon = icons[name];
---

<Icon size={size} stroke-width={1.65} aria-hidden="true" />
