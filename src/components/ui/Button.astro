---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "quiet" | "on-dark" | "ghost-dark";
  arrow?: boolean;
  /** Load-in ring, when the button sits in the first viewport. */
  ring?: number;
  class?: string;
}

const {
  href,
  variant = "primary",
  arrow = false,
  ring,
  class: className,
} = Astro.props;
const external = href.startsWith("http");
---

<a
  class:list={["btn", `btn--${variant}`, className]}
  href={href}
  rel={external ? "noopener" : undefined}
  data-ring={ring}
>
  <slot />
  {arrow && <Icon name="arrowUpRight" size={17} stroke={2} />}
</a>
