---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span
  class:list={["brand-lockup", { "brand-lockup--compact": compact }]}
  role="img"
  aria-label="Cube27 AI"
>
  <img
    src="/cube27-mark.svg"
    alt=""
    width="64"
    height="64"
    loading="eager"
    decoding="async"
  />
  <span class="brand-wordmark" aria-hidden="true"
    >CUBE<span class="brand-number">27</span> AI</span
  >
</span>
