---
interface Props {
  href?: string;
}

const { href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class="brand-lockup" href={href}>
  <img
    src="/cube27-mark.svg"
    alt=""
    width="34"
    height="34"
    loading="eager"
    decoding="async"
  />
  <span class="brand-wordmark">CUBE<span class="brand-number">27</span> AI</span
  >
</Tag>
