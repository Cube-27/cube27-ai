---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  href: string;
  /** Covers the whole positioned ancestor, making an entire card clickable. */
  stretch?: boolean;
  /** Load-in ring, when the link sits in the first viewport. */
  ring?: number;
  class?: string;
}

const { href, stretch = false, ring, class: className } = Astro.props;
const external = href.startsWith("http");
---

<a
  class:list={["tlink", { stretch }, className]}
  href={href}
  rel={external ? "noopener" : undefined}
  data-ring={ring}
>
  <span class="tlink__label"><slot /></span>
  <Icon name="arrowUpRight" size={16} stroke={2} />
</a>
