---
import { Picture } from "astro:assets";
import { CircleCheck } from "@lucide/astro";
import patternsAssembly from "@/assets/images/patterns-assembly.png";
import { SERVICE_PATTERNS } from "@/data/site";
import SectionLead from "@/components/ui/SectionLead.astro";
import SystemIcon from "@/components/ui/SystemIcon.astro";
---

<section
  id="patterns"
  class="section-shell patterns-section"
  data-rail="PATTERNS"
>
  <div class="patterns-visual" aria-hidden="true">
    <Picture
      src={patternsAssembly}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[480, 720, 960]}
      sizes="(max-width: 760px) 100vw, 42vw"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div class="image-diagnostic pattern-diagnostic">
      <span>SYS: PT-07</span><span>QUALITY: ACTIVE</span><span
        >CONTROL: ENABLED</span
      >
    </div>
  </div>
  <div class="patterns-content">
    <SectionLead
      eyebrow="Production patterns"
      title="Production AI patterns."
      copy="The building blocks for reliable AI systems."
    />
    <div class="pattern-list">
      {
        SERVICE_PATTERNS.map((pattern) => (
          <article class="pattern-row">
            <span class:list={["pattern-icon", `pattern-${pattern.tone}`]}>
              <SystemIcon name={pattern.icon} size={17} />
            </span>
            <div>
              <h3>{pattern.name}</h3>
              <p>{pattern.detail}</p>
            </div>
            <span class="pattern-action">
              <CircleCheck size={16} aria-hidden="true" />
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>
