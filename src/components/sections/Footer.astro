---
import Logo from "@/components/ui/Logo.astro";
import { FOOTER_LINKS, PRODUCT_LINKS, SITE } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="shell">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo />
        <p class="t-body site-footer__blurb">
          CUBE27 builds production AI systems for workflows where teams spend
          too much time collecting information, reconciling data and reviewing
          documents.
        </p>
      </div>

      <div class="footer-col">
        <h2 class="footer-col__title">Products</h2>
        <ul>
          {
            PRODUCT_LINKS.map((product) => (
              <li>
                <a href={product.href}>{product.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-col__title">Company</h2>
        <ul>
          {
            FOOTER_LINKS.map((link) => (
              <li>
                <a href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__base">
      <p>&copy; {year} {SITE.organization.legalName}. All rights reserved.</p>
      <p>CUBE27 AI is part of CUBE27.</p>
    </div>
  </div>
</footer>
