---
import { CircleCheck } from "@lucide/astro";
import { SITE } from "@/data/site";
import Logo from "@/components/ui/Logo.astro";
---

<footer class="section-shell site-footer">
  <Logo compact />
  <p class="footer-note">
    <CircleCheck size={14} aria-hidden="true" /> Engineering the intelligent enterprise.
  </p>
  <nav class="footer-links" aria-label="Legal and company links">
    <a href={SITE.parentUrl}>cube27.com</a>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a href={SITE.privacyUrl}>Privacy</a>
    <a href={SITE.termsUrl}>Terms</a>
  </nav>
</footer>
