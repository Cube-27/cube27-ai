---
import Button from "@/components/ui/Button.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import TextLink from "@/components/ui/TextLink.astro";
import ProductVisual from "@/components/visuals/ProductVisual.astro";
import { HERO } from "@/data/home";
import { PRODUCTS } from "@/data/products";
import { CTA, PRODUCT_LINKS, SITE } from "@/data/site";

/* The pane at the foot of the hero. The first product, so the strip above it
   and the stage below it agree, and so the featured product is a property of
   the product order rather than a name copied into the markup. */
const FEATURED = PRODUCTS[0];
---

<section class="hero">
  <div class="shell hero__inner">
    {
      /*
       * The hero is the first viewport, so it rides the load-in ripple rather
       * than the scroll reveal. The proposition opens the wave; the lead and
       * the support line sit close enough together on screen to read as one
       * arrival, so they share a ring; the actions land last.
       *
       * One button, not two. The three actions that used to compete here —
       * two of them pointing at the same contact page — read as a choice the
       * visitor has to make before they know anything. The page's own answer
       * is the products, so that is the button; bringing us a workflow stays
       * available as a link beside it and as the header's standing action,
       * and gets its own section at the foot of the page.
       */
    }
    <SectionHead
      level={1}
      title={HERO.title}
      lead={HERO.lead}
      flush
      rings={{ title: 0, lead: 1 }}
    >
      <p class="t-body hero__support" data-ring={1}>{HERO.support}</p>
      <div class="btn-row btn-row--center hero__actions">
        <Button href="#products" variant="primary" ring={2}>
          {CTA.products}
        </Button>
        <TextLink href={SITE.contactUrl} ring={2}>{CTA.workflow}</TextLink>
      </div>

      {
        /*
         * The four domains the support paragraph used to list in one run-on
         * sentence. As links they do the same work the sentence did and one
         * more besides: they are the shortest path from the first viewport
         * into the product that matches why the visitor came.
         *
         * Each plate carries its product's hue, so the strip is a legend for
         * the cards further down the page: the colour a visitor picks up here
         * is the colour of the card they land on. The hue arrives on hover
         * rather than at rest — four saturated pills under the proposition
         * would out-shout the one button beside them.
         */
      }
      <ul class="hero__domains">
        {
          PRODUCT_LINKS.map((product) => (
            <li>
              <a
                class="hero__domain"
                href={product.href}
                data-hue={product.hue}
                data-ring={3}
              >
                <span class="hero__domain-label">{product.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </SectionHead>
  </div>

  {
    /*
     * The stage. A real product surface in the first viewport, cropped by the
     * foot of the section so only its head shows: the pane reads as rising
     * into the fold rather than sitting in it, and the crop is what says there
     * is more below. The height is fixed rather than left to the viewport, so
     * the cut lands on the pane's header and first rows at every size instead
     * of wherever the fold happens to fall.
     *
     * Outside the shell's centred column but inside the section, so it can
     * carry its own width and sit flush to the bottom edge.
     */
  }
  <div class="hero__stage" data-hue={FEATURED.hue} data-ring={4}>
    <div class="hero__stage-pane">
      <ProductVisual visual={FEATURED.visual} />
    </div>
  </div>
</section>
