---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import TextLink from "@/components/ui/TextLink.astro";
import prismLedger from "@/assets/images/hero-prism-ledger.webp";
import prismRoutes from "@/assets/images/hero-prism-routes.webp";
import { HERO } from "@/data/home";
import { CTA, PRODUCT_LINKS, SITE } from "@/data/site";
---

<section class="hero">
  {
    /*
     * The first viewport is one high-key ivory plane with a photographed
     * acrylic architecture set into its right half. Two plates carry it and
     * every other mark on the band is drawn in CSS.
     *
     * Nothing inside the media layer takes a z-index. Each plate blends with
     * multiply, and a blended element only sees the backdrop of its own
     * stacking context — a z-index anywhere up the chain would cut the plates
     * off from the ivory underneath and the blend would silently become a
     * straight paste. DOM order carries the stack instead.
     */
  }
  <div class="hero__media" aria-hidden="true">
    <Image
      class="hero__art"
      src={prismLedger}
      alt=""
      widths={[900, 1400, 2200]}
      sizes="72vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />

    {
      /* The wash, not the plate's own opacity, is what guarantees the left
         column stays quiet enough for dark text: the artwork can fail to load
         or land any way it likes and the measure still reads. */
    }
    <div class="hero__wash"></div>
    <div class="hero__grid"></div>
    <div class="hero__rails"></div>

    {
      /* The data instrument. The routes plate is the fine network density
         behind it; the acrylic panels, hairlines and nodes over it are drawn. */
    }
    <div class="hero__instrument">
      <Image
        class="hero__routes"
        src={prismRoutes}
        alt=""
        widths={[600, 1200]}
        sizes="46vw"
        loading="eager"
        decoding="async"
      />
      <span class="hero__panel hero__panel--wide"></span>
      <span class="hero__panel hero__panel--tall"></span>
      <div class="hero__net"></div>
      <span class="hero__node hero__node--cobalt"></span>
      <span class="hero__node hero__node--emerald"></span>
      <span class="hero__node hero__node--magenta"></span>
      <span class="hero__node hero__node--violet"></span>
      <span class="hero__ring hero__ring--cobalt"></span>
      <span class="hero__ring hero__ring--magenta"></span>
    </div>

    <div class="hero__grain"></div>
  </div>
  <div class="shell hero__inner">
    {
      /*
       * The hero is the first viewport, so it rides the load-in ripple rather
       * than the scroll reveal. The proposition opens the wave, the lead
       * follows, and the actions land last.
       *
       * One button, not two. The three actions that used to compete here —
       * two of them pointing at the same contact page — read as a choice the
       * visitor has to make before they know anything. The page's own answer
       * is the products, so that is the button; bringing us a workflow stays
       * available as a link beside it and as the header's standing action,
       * and gets its own section at the foot of the page.
       */
    }
    <SectionHead
      level={1}
      title={HERO.title}
      lead={HERO.lead}
      align="start"
      flush
      rings={{ title: 0, lead: 1 }}
    >
      <div class="btn-row hero__actions">
        <Button href="#products" variant="primary" ring={2}>
          {CTA.products}
        </Button>
        <TextLink href={SITE.contactUrl} ring={2}>{CTA.workflow}</TextLink>
      </div>

      {
        /*
         * The four domains the support paragraph used to list in one run-on
         * sentence. As links they do the same work the sentence did and one
         * more besides: they are the shortest path from the first viewport
         * into the product that matches why the visitor came.
         *
         * Each plate carries its product's hue, so the strip is a legend for
         * the cards further down the page: the colour a visitor picks up here
         * is the colour of the card they land on. The hue arrives on hover
         * rather than at rest — four saturated pills under the proposition
         * would out-shout the one button beside them.
         */
      }
      <ul class="hero__domains">
        {
          PRODUCT_LINKS.map((product) => (
            <li>
              <a
                class="hero__domain"
                href={product.href}
                data-hue={product.hue}
                data-ring={3}
              >
                <span class="hero__domain-label">{product.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </SectionHead>
  </div>
</section>

<script>
  /*
   * Pointer parallax for the three plates. The script owns two numbers and
   * nothing else: --hero-px and --hero-py, each in the range -1..1. Every
   * distance those two numbers turn into lives in hero.css, so the depth
   * order is readable there rather than split across two files.
   *
   * It writes through the CSSOM rather than a style attribute, which the
   * page's `style-src 'self'` allows and an attribute would not.
   */
  const hero = document.querySelector<HTMLElement>(".hero");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && fine.matches && !still.matches) {
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let frame = 0;

    /* Eased toward the pointer rather than pinned to it: a plate that tracks
       the cursor exactly reads as a cursor, and one that eases reads as
       weight. */
    const step = () => {
      x += (targetX - x) * 0.08;
      y += (targetY - y) * 0.08;
      hero.style.setProperty("--hero-px", x.toFixed(4));
      hero.style.setProperty("--hero-py", y.toFixed(4));

      if (Math.abs(targetX - x) > 0.001 || Math.abs(targetY - y) > 0.001) {
        frame = requestAnimationFrame(step);
      } else {
        frame = 0;
      }
    };

    const run = () => {
      if (!frame) frame = requestAnimationFrame(step);
    };

    hero.addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType !== "mouse") return;
        const box = hero.getBoundingClientRect();
        /* -1 at one edge, +1 at the other, so the distances in the
           stylesheet are amplitudes rather than half-amplitudes. */
        targetX = ((event.clientX - box.left) / box.width - 0.5) * 2;
        targetY = ((event.clientY - box.top) / box.height - 0.5) * 2;
        run();
      },
      { passive: true },
    );

    hero.addEventListener("pointerleave", () => {
      targetX = 0;
      targetY = 0;
      run();
    });
  }
</script>
