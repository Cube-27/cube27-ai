---
import { ArrowUpRight, Menu, X } from "@lucide/astro";
import { NAV_ITEMS, SITE } from "@/data/site";
import Logo from "@/components/ui/Logo.astro";
---

<header class="site-header">
  <a class="brand-home" href="#top" aria-label="Cube27 AI home">
    <Logo />
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {NAV_ITEMS.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <a class="header-cta" href={SITE.contactUrl}>
    Start a conversation <ArrowUpRight size={15} aria-hidden="true" />
  </a>

  <details class="mobile-nav">
    <summary>
      <span class="sr-only">Navigation menu</span>
      <Menu class="menu-open" size={24} aria-hidden="true" />
      <X class="menu-close" size={24} aria-hidden="true" />
    </summary>
    <nav aria-label="Mobile navigation">
      {
        NAV_ITEMS.map((item) => (
          <a class="mobile-section-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a href={SITE.contactUrl}>
        Start a conversation <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </nav>
  </details>
</header>
