---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { CTA, NAV_ITEMS, PRODUCT_LINKS, SITE } from "@/data/site";
---

<header class="site-header">
  <div class="shell site-header__inner">
    <Logo href="/" />

    <nav class="desktop-nav" aria-label="Primary">
      <div class="nav-menu">
        <a class="nav-link" href="/#products">
          Products
          <Icon
            name="chevronDown"
            size={15}
            stroke={2}
            class="nav-menu__chevron"
          />
        </a>
        <div class="nav-menu__panel">
          {
            PRODUCT_LINKS.map((product) => (
              <a class="nav-menu__item" href={product.href}>
                <span class="nav-menu__name">{product.label}</span>
                <span class="nav-menu__promise">{product.promise}</span>
              </a>
            ))
          }
        </div>
      </div>
      {
        NAV_ITEMS.map((item) => (
          <a class="nav-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <Button href={SITE.contactUrl} variant="primary" class="btn--desktop">
        {CTA.primary}
      </Button>

      {
        /*
         * The popover API supplies light dismiss — outside click and Escape —
         * plus focus handling, so opening and closing the menu needs no
         * JavaScript. The one case it cannot cover is a link to an anchor on
         * the page already showing: that never unloads the document, so the
         * panel would stay in the top layer over the section it just jumped
         * to. The script at the foot of this file closes it for that case.
         */
      }
      <div class="mobile-nav">
        <button
          class="mobile-nav__toggle"
          type="button"
          popovertarget="mobile-menu"
          aria-label="Menu"
        >
          <Icon name="menu" size={22} stroke={1.9} />
        </button>

        {
          /*
           * A full-height sheet, not a floating card: the panel covers the
           * header, so it carries its own header row — same lockup, same
           * 46px control in the same place — and the close button lands
           * exactly where the thumb just tapped open.
           */
        }
        <div class="mobile-nav__panel" id="mobile-menu" popover>
          <div class="mobile-nav__head">
            <Logo href="/" />
            <button
              class="mobile-nav__close"
              type="button"
              popovertarget="mobile-menu"
              popovertargetaction="hide"
              aria-label="Close menu"
            >
              <Icon name="close" size={22} stroke={1.9} />
            </button>
          </div>

          <nav class="mobile-nav__body" aria-label="Primary mobile">
            <div class="mobile-nav__group">
              <p class="mobile-nav__label">Products</p>
              <div class="mobile-nav__links">
                {
                  PRODUCT_LINKS.map((product) => (
                    <a class="mobile-nav__link" href={product.href}>
                      {product.label}
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="mobile-nav__group">
              <p class="mobile-nav__label">Company</p>
              <div class="mobile-nav__links">
                {
                  NAV_ITEMS.map((item) => (
                    <a class="mobile-nav__link" href={item.href}>
                      {item.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </nav>

          <Button href={SITE.contactUrl} variant="secondary">
            {CTA.primary}
          </Button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  /*
   * Bundled, never inline, so the CSP needs no script-src exception. Delegated
   * from the panel so it survives however the links are rendered, and guarded
   * on :popover-open because hidePopover() throws on a closed popover.
   */
  const panel = document.getElementById("mobile-menu");

  panel?.addEventListener("click", (event) => {
    const click = event as MouseEvent;
    const target = event.target as Element | null;
    const link = target?.closest<HTMLAnchorElement>("a");
    if (
      !link ||
      event.defaultPrevented ||
      click.button !== 0 ||
      click.metaKey ||
      click.ctrlKey ||
      click.shiftKey ||
      click.altKey ||
      link.hasAttribute("download") ||
      (link.target && link.target !== "_self")
    )
      return;

    event.preventDefault();
    if (panel.matches(":popover-open")) panel.hidePopover();
    const delay = matchMedia("(prefers-reduced-motion: reduce)").matches
      ? 0
      : 220;
    window.setTimeout(() => location.assign(link.href), delay);
  });
</script>
