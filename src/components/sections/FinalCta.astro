---
import { ArrowRight } from "@lucide/astro";
import { SITE } from "@/data/site";
---

<section class="section-shell final-cta" data-rail="ACTIVATE // 05">
  <div class="cta-pulse" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div>
    <p class="eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>YOUR NEXT SYSTEM
    </p>
    <h2>Let’s turn an AI idea into an operational advantage.</h2>
  </div>
  <a class="primary-button primary-button-large" href={SITE.contactUrl}>
    START A CONVERSATION <ArrowRight size={18} aria-hidden="true" />
  </a>
</section>
