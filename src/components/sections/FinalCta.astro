---
import Button from "@/components/ui/Button.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { FINAL_CTA } from "@/data/home";
import { CTA, SITE } from "@/data/site";
---

<section class="band band--dark on-dark cta-band">
  <div class="shell cta-band__inner">
    <SectionHead
      title={FINAL_CTA.title}
      lead={FINAL_CTA.lead}
      align="start"
      flush
    />
    <div class="cta-band__actions" data-reveal data-reveal-delay="1">
      <Button href={SITE.contactUrl} variant="on-dark" arrow>
        {CTA.primary}
      </Button>
      <Button href="/#products" variant="ghost-dark">{CTA.products}</Button>
    </div>
  </div>
</section>
