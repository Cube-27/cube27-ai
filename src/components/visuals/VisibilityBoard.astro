---
interface Props {
  label?: string;
}

const { label } = Astro.props;

const rows = [
  { name: "Your brand", share: 0.46, own: true },
  { name: "Competitor A", share: 0.64, own: false },
  { name: "Competitor B", share: 0.37, own: false },
  { name: "Competitor C", share: 0.19, own: false },
];

const TRACK_X = 214;
const TRACK_W = 452;
const sources = [
  { name: "docs.yoursite.com", weight: 0.72 },
  { name: "industry-review.com", weight: 0.54 },
  { name: "community thread", weight: 0.31 },
];
---

<svg
  class="visual"
  viewBox="0 0 800 500"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  font-family="var(--font-body)"
>
  <rect width="800" height="500" fill="#ffffff"></rect>

  <!-- header -->
  <text x="40" y="56" font-size="19" font-weight="600" fill="var(--c-ink)"
    >Answer-engine visibility</text
  >
  <rect x="632" y="36" width="128" height="28" rx="14" fill="var(--card-soft)"
  ></rect>
  <text
    x="696"
    y="55"
    font-size="13"
    font-weight="500"
    text-anchor="middle"
    fill="var(--card-deep)">Last 30 days</text
  >
  <text x="40" y="80" font-size="13.5" fill="var(--c-ink-3)"
    >Share of tracked questions where the brand is cited</text
  >

  <!-- comparison rows -->
  {
    rows.map((row, index) => {
      const y = 130 + index * 62;
      return (
        <g>
          <text
            x="40"
            y={y + 5}
            font-size="14.5"
            font-weight={row.own ? "600" : "400"}
            fill={row.own ? "var(--c-ink)" : "var(--c-ink-2)"}
          >
            {row.name}
          </text>
          <rect
            x={TRACK_X}
            y={y - 7}
            width={TRACK_W}
            height="12"
            rx="6"
            fill="var(--c-band)"
          />
          <rect
            x={TRACK_X}
            y={y - 7}
            width={Math.round(TRACK_W * row.share)}
            height="12"
            rx="6"
            fill={row.own ? "var(--card-mid)" : "var(--card-soft)"}
          />
          {!row.own && (
            <rect
              x={TRACK_X}
              y={y - 7}
              width={Math.round(TRACK_W * row.share)}
              height="12"
              rx="6"
              fill="var(--card-mid)"
              opacity="0.34"
            />
          )}
          <text
            x="760"
            y={y + 5}
            font-size="14.5"
            font-weight="600"
            text-anchor="end"
            fill={row.own ? "var(--card-deep)" : "var(--c-ink-3)"}
          >
            {Math.round(row.share * 100)}%
          </text>
        </g>
      );
    })
  }

  <!-- evidence strip -->
  <rect x="40" y="380" width="720" height="86" rx="14" fill="var(--c-band)"
  ></rect>
  <text
    x="62"
    y="410"
    font-size="12.5"
    font-weight="600"
    letter-spacing="0.04em"
    fill="var(--c-ink-3)">SOURCES INFLUENCING THE ANSWER</text
  >
  {
    sources.map((source, index) => {
      const x = 62 + index * 236;
      return (
        <g>
          <circle cx={x + 5} cy="437" r="4.5" fill="var(--card-mid)" />
          <text x={x + 20} y="442" font-size="13.5" fill="var(--c-ink-2)">
            {source.name}
          </text>
          <rect x={x} y="452" width="196" height="5" rx="2.5" fill="#ffffff" />
          <rect
            x={x}
            y="452"
            width={Math.round(196 * source.weight)}
            height="5"
            rx="2.5"
            fill="var(--card-mid)"
            opacity="0.6"
          />
        </g>
      );
    })
  }
</svg>
