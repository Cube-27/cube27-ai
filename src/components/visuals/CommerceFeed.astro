---
import VisualFrame from "@/components/visuals/VisualFrame.astro";

interface Props {
  label?: string;
}

const { label } = Astro.props;

const filters = [
  { name: "All", count: "12", width: 62, active: true },
  { name: "Price", count: "7", width: 70, active: false },
  { name: "Stock", count: "3", width: 72, active: false },
  { name: "Assortment", count: "2", width: 110, active: false },
];

/**
 * `fromWidth` and `pillWidth` are measured, not derived: SVG cannot lay text
 * out, and the arrow and the delta pill have to sit against real glyph widths.
 */
const changes = [
  {
    title: "1L Cold-Press Oil",
    meta: "SKU-4417 · marketmart.in · 2 min ago",
    field: "Price",
    fieldWidth: 60,
    from: "₹1,249",
    fromWidth: 48,
    to: "₹1,099",
    delta: "12%",
    dir: "down",
    pillWidth: 64,
  },
  {
    title: "Refill Pack 500 ml",
    meta: "SKU-8802 · quickcart.com · 14 min ago",
    field: "Availability",
    fieldWidth: 92,
    from: "In stock",
    fromWidth: 50,
    to: "Out of stock",
    delta: "0 left",
    dir: null,
    pillWidth: 62,
  },
  {
    title: "Starter Kit",
    meta: "SKU-2310 · marketmart.in · 41 min ago",
    field: "Price",
    fieldWidth: 60,
    from: "₹2,499",
    fromWidth: 48,
    to: "₹2,749",
    delta: "10%",
    dir: "up",
    pillWidth: 64,
  },
  {
    title: "Glass Dispenser 750 ml",
    meta: "SKU-6690 · shopnest.in · 1 h ago",
    field: "Assortment",
    fieldWidth: 88,
    from: "Not listed",
    fromWidth: 58,
    to: "Newly listed",
    delta: "New",
    dir: null,
    pillWidth: 52,
  },
  {
    title: "Travel Set · 3 pack",
    meta: "SKU-1128 · quickcart.com · 2 h ago",
    field: "Price",
    fieldWidth: 60,
    from: "₹899",
    fromWidth: 36,
    to: "₹849",
    delta: "6%",
    dir: "down",
    pillWidth: 58,
  },
];

const CHANGE_X = 492;

const caret = (cx: number, cy: number, up: boolean) =>
  up ? `M${cx} ${cy - 3.6}l4.4 6.4h-8.8z` : `M${cx} ${cy + 3.6}l4.4-6.4h-8.8z`;
---

<VisualFrame
  label={label}
  icon="pulse"
  title="Change monitor"
  subtitle="1,840 SKUs watched across 6 storefronts"
  bleed
>
  <Fragment slot="aside">
    <text
      x="648"
      y="68"
      font-size="11.5"
      text-anchor="end"
      fill="var(--c-ink-3)">12 changes today</text
    >
    <rect x="666" y="48" width="86" height="32" rx="16" fill="var(--card-soft)"
    ></rect>
    <circle cx="686" cy="64" r="4" fill="var(--card-mid)"></circle>
    <text
      x="698"
      y="68"
      font-size="11.5"
      font-weight="600"
      fill="var(--card-deep)">Live</text
    >
  </Fragment>

  {
    filters.map((filter, index) => {
      const x =
        48 + filters.slice(0, index).reduce((sum, f) => sum + f.width + 8, 0);
      return (
        <g>
          <rect
            x={x}
            y="114"
            width={filter.width}
            height="28"
            rx="14"
            fill={filter.active ? "var(--card-deep)" : "var(--c-band)"}
          />
          <text
            x={x + filter.width / 2}
            y="132"
            font-size="11"
            font-weight="600"
            text-anchor="middle"
            fill={filter.active ? "#ffffff" : "var(--c-ink-2)"}
          >
            {`${filter.name}  ${filter.count}`}
          </text>
        </g>
      );
    })
  }

  {
    changes.map((change, index) => {
      const top = 152 + index * 78;
      const mid = top + 38;
      const arrowX = CHANGE_X + change.fromWidth + 10;
      const toX = arrowX + 28;
      const pillX = 752 - change.pillWidth;
      return (
        <g>
          {index === 0 && (
            <rect
              x="48"
              y={top}
              width="704"
              height="72"
              rx="14"
              fill="var(--card-soft)"
            />
          )}

          <rect
            x="64"
            y={mid - 24}
            width="48"
            height="48"
            rx="13"
            fill="var(--c-band)"
          />
          <rect
            x="80"
            y={mid - 8}
            width="16"
            height="20"
            rx="4"
            fill="var(--card-mid)"
            opacity="0.34"
          />
          <rect
            x="84"
            y={mid - 14}
            width="8"
            height="7"
            rx="2"
            fill="var(--card-mid)"
            opacity="0.6"
          />

          <text
            x="126"
            y={mid - 4}
            font-size="14"
            font-weight="600"
            letter-spacing="-0.012em"
            fill="var(--c-ink)"
          >
            {change.title}
          </text>
          <text x="126" y={mid + 16} font-size="11.5" fill="var(--c-ink-3)">
            {change.meta}
          </text>

          <rect
            x="380"
            y={mid - 12}
            width={change.fieldWidth}
            height="24"
            rx="12"
            fill="#ffffff"
            stroke="#0c1024"
            stroke-opacity="0.08"
          />
          <text
            x={380 + change.fieldWidth / 2}
            y={mid + 4}
            font-size="10.5"
            font-weight="600"
            text-anchor="middle"
            fill="var(--c-ink-2)"
          >
            {change.field}
          </text>

          <text
            x={CHANGE_X}
            y={mid + 4.5}
            font-size="12.5"
            fill="var(--c-ink-3)"
            text-decoration="line-through"
          >
            {change.from}
          </text>
          <path
            d={`M${arrowX} ${mid}h16m-5.5-5 5.5 5-5.5 5`}
            fill="none"
            stroke="var(--c-ink-3)"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <text
            x={toX}
            y={mid + 4.5}
            font-size="13.5"
            font-weight="600"
            fill="var(--c-ink)"
          >
            {change.to}
          </text>

          <rect
            x={pillX}
            y={mid - 12}
            width={change.pillWidth}
            height="24"
            rx="12"
            fill="var(--card-mid)"
            opacity="0.16"
          />
          {change.dir && (
            <path
              d={caret(pillX + 15, mid, change.dir === "up")}
              fill="var(--card-deep)"
            />
          )}
          <text
            x={change.dir ? pillX + 26 : pillX + change.pillWidth / 2}
            y={mid + 4}
            font-size="11"
            font-weight="600"
            text-anchor={change.dir ? "start" : "middle"}
            fill="var(--card-deep)"
          >
            {change.delta}
          </text>

          {index > 0 && (
            <path
              d={`M48 ${top - 3}h704`}
              stroke="#0c1024"
              stroke-opacity="0.07"
            />
          )}
        </g>
      );
    })
  }
</VisualFrame>
