---
interface Props {
  label?: string;
}

const { label } = Astro.props;

const stages = [
  { name: "Ordered", qty: 1200, share: 1 },
  { name: "Dispatched", qty: 940, share: 0.783 },
  { name: "Invoiced", qty: 940, share: 0.783 },
  { name: "Received", qty: 880, share: 0.733 },
];

const BAR_X = 210;
const BAR_W = 470;
---

<svg
  class="visual"
  viewBox="0 0 800 500"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  font-family="var(--font-body)"
>
  <rect width="800" height="500" fill="#ffffff"></rect>

  <text x="40" y="56" font-size="19" font-weight="600" fill="var(--c-ink)"
    >PO-2291 · reconciliation</text
  >
  <text x="40" y="80" font-size="13.5" fill="var(--c-ink-3)"
    >One commitment, four events, one outstanding balance</text
  >

  <!-- quantity ladder -->
  {
    stages.map((stage, index) => {
      const y = 138 + index * 64;
      return (
        <g>
          <circle cx="52" cy={y - 2} r="6" fill="var(--card-mid)" />
          {index < stages.length - 1 && (
            <path
              d={`M52 ${y + 6}v44`}
              stroke="var(--card-mid)"
              stroke-width="1.8"
              opacity="0.35"
              stroke-linecap="round"
            />
          )}
          <text x="76" y={y + 3} font-size="14.5" fill="var(--c-ink-2)">
            {stage.name}
          </text>
          <rect
            x={BAR_X}
            y={y - 11}
            width={BAR_W}
            height="18"
            rx="9"
            fill="var(--c-band)"
          />
          <rect
            x={BAR_X}
            y={y - 11}
            width={Math.round(BAR_W * stage.share)}
            height="18"
            rx="9"
            fill="var(--card-mid)"
            opacity={index === 0 ? "0.28" : "0.72"}
          />
          <text
            x="760"
            y={y + 4}
            font-size="14.5"
            font-weight="600"
            text-anchor="end"
            fill="var(--c-ink)"
          >
            {stage.qty.toLocaleString("en-IN")}
          </text>
        </g>
      );
    })
  }

  <!-- exception callout -->
  <rect x="40" y="398" width="720" height="72" rx="14" fill="var(--card-soft)"
  ></rect>
  <circle cx="72" cy="434" r="14" fill="var(--card-mid)" opacity="0.18"
  ></circle>
  <path
    d="M66 434h12M72 428v12"
    stroke="var(--card-deep)"
    stroke-width="2"
    stroke-linecap="round"></path>
  <text x="102" y="428" font-size="14.5" font-weight="600" fill="var(--c-ink)"
    >60 units invoiced but not yet received</text
  >
  <text x="102" y="450" font-size="13" fill="var(--c-ink-3)"
    >Flagged automatically against SRV-1184 · awaiting store confirmation</text
  >
</svg>
