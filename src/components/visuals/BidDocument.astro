---
import Glyph from "@/components/visuals/Glyph.astro";
import VisualFrame from "@/components/visuals/VisualFrame.astro";

interface Props {
  label?: string;
}

const { label } = Astro.props;

const requirements = [
  {
    text: "ISO 27001 certification",
    source: "p. 14 · §3.2",
    state: "Evidence attached",
    owner: "AR",
    met: true,
  },
  {
    text: "3 comparable rail references",
    source: "p. 27 · §4.1",
    state: "Evidence attached",
    owner: "SM",
    met: true,
  },
  {
    text: "Local support within 4 hours",
    source: "p. 61 · §6.4",
    state: "Awaiting SME input",
    owner: "PK",
    met: false,
  },
  {
    text: "Bid bond, 2% of contract value",
    source: "p. 88 · §9.1",
    state: "Evidence attached",
    owner: "AR",
    met: true,
  },
];

// Text-line widths for the rendered page, in user units.
const lines = [
  216, 198, 208, 172, 212, 190, 204, 158, 210, 196, 182, 206, 174, 200, 188,
  212, 166, 202,
];

// The two lines the extractor pulled the first requirement from.
const HIGHLIGHT = [3, 4];
---

<VisualFrame
  label={label}
  icon="file"
  title="Metro Rail RFP · Volume 2"
  subtitle="tender_metro_rail_vol2.pdf · 212 pages · added 06 Mar"
  bleed
  bleedX={24}
  bleedWidth={300}
>
  <Fragment slot="aside">
    <text
      x="752"
      y="58"
      font-size="11"
      font-weight="600"
      text-anchor="end"
      fill="var(--c-ink-2)">18 of 24 requirements mapped</text
    >
    <rect x="596" y="68" width="156" height="6" rx="3" fill="var(--c-band)"
    ></rect>
    <rect x="596" y="68" width="117" height="6" rx="3" fill="var(--card-mid)"
    ></rect>
  </Fragment>

  <!-- document viewer, running off the bottom edge -->
  <rect x="48" y="118" width="272" height="410" rx="14" fill="var(--c-band)"
  ></rect>
  <rect
    x="64"
    y="132"
    width="128"
    height="24"
    rx="12"
    fill="#ffffff"
    stroke="#0c1024"
    stroke-opacity="0.08"></rect>
  <text
    x="128"
    y="148"
    font-size="10.5"
    font-weight="600"
    text-anchor="middle"
    fill="var(--c-ink-2)">§3 Requirements</text
  >
  <text
    x="304"
    y="148"
    font-size="10.5"
    font-weight="600"
    text-anchor="end"
    fill="var(--c-ink-3)">p. 14 / 212</text
  >

  <rect
    x="64"
    y="168"
    width="240"
    height="360"
    rx="8"
    fill="#ffffff"
    stroke="#0c1024"
    stroke-opacity="0.07"></rect>
  <rect
    x="84"
    y="190"
    width="120"
    height="10"
    rx="5"
    fill="var(--card-deep)"
    opacity="0.5"></rect>
  <rect
    x="76"
    y={214 + HIGHLIGHT[0] * 17 - 10}
    width="220"
    height={HIGHLIGHT.length * 17 + 4}
    rx="5"
    fill="var(--card-mid)"
    opacity="0.14"></rect>
  <rect
    x="76"
    y={214 + HIGHLIGHT[0] * 17 - 10}
    width="3"
    height={HIGHLIGHT.length * 17 + 4}
    rx="1.5"
    fill="var(--card-mid)"></rect>
  {
    lines.map((width, index) => {
      const on = HIGHLIGHT.includes(index);
      return (
        <rect
          x="84"
          y={214 + index * 17}
          width={width}
          height="6"
          rx="3"
          fill={on ? "var(--card-deep)" : "var(--c-ink-3)"}
          opacity={on ? "0.6" : "0.24"}
        />
      );
    })
  }

  <!-- requirements extracted from it -->
  {
    requirements.map((requirement, index) => {
      const top = 118 + index * 97;
      return (
        <g>
          <rect
            x="336"
            y={top}
            width="416"
            height="84"
            rx="14"
            fill="var(--card-soft)"
          />
          <rect
            x="356"
            y={top + 17}
            width="26"
            height="26"
            rx="9"
            fill={requirement.met ? "var(--card-mid)" : "#ffffff"}
            opacity={requirement.met ? "0.22" : "1"}
          />
          <Glyph
            name={requirement.met ? "check" : "clock"}
            x={360}
            y={top + 21}
            size={18}
            color={requirement.met ? "var(--card-deep)" : "var(--c-ink-3)"}
            stroke={requirement.met ? 2.4 : 1.9}
          />

          <text
            x={396}
            y={top + 34}
            font-size="13"
            font-weight="600"
            letter-spacing="-0.012em"
            fill="var(--c-ink)"
          >
            {requirement.text}
          </text>

          <rect
            x="396"
            y={top + 46}
            width="88"
            height="20"
            rx="10"
            fill="#ffffff"
          />
          <text
            x="440"
            y={top + 60}
            font-size="10"
            font-weight="600"
            text-anchor="middle"
            fill="var(--c-ink-3)"
          >
            {requirement.source}
          </text>
          <text x="496" y={top + 60} font-size="10.5" fill="var(--c-ink-3)">
            {requirement.state}
          </text>

          <circle
            cx="722"
            cy={top + 42}
            r="14"
            fill="var(--card-mid)"
            opacity="0.18"
          />
          <text
            x="722"
            y={top + 46}
            font-size="10.5"
            font-weight="700"
            text-anchor="middle"
            fill="var(--card-deep)"
          >
            {requirement.owner}
          </text>
        </g>
      );
    })
  }
</VisualFrame>
