+        try {
+            rmSync(userDataDir, { recursive: true, force: true, maxRetries: 10 });
+        }
+        catch (err) {
+            // A successful Lighthouse run should not fail because Windows is
+            // still releasing a Chrome profile file during best-effort cleanup.
+            if (!isWindows || (err.code !== 'EPERM' && err.code !== 'EBUSY')) {
+                throw err;
+            }
+            log.warn('ChromeLauncher', `Unable to remove temporary profile ${userDataDir}`, err);
+        }
     }
